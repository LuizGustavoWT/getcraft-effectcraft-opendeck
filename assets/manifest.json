{
  "Name": "EffectCraft CLI",
  "Description": "Live timeline, layers, effects, render-queue and rotary property controls for EffectCraft on OpenDeck (Linux).",
  "Author": "LuizGustavoWT",
  "Version": "0.2.0",
  "PluginUUID": "wt.luizgustavo.getcraft.effectcraft",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/getcraft-effectcraft-opendeck"
  },
  "CodePathLin": "x86_64-unknown-linux-gnu/bin/getcraft-effectcraft-opendeck",
  "Icon": "assets/icon",
  "Category": "GetCraft",
  "OS": [{ "Platform": "linux" }],
  "Actions": [
    {
      "UUID": "wt.luizgustavo.getcraft.effectcraft.run",
      "Name": "Run EffectCraft CLI",
      "Icon": "assets/action",
      "States": [{
        "Image": "assets/action",
        "TitleAlignment": "bottom",
        "TitleColor": "#FFFFFF",
        "FontSize": "12"
      }],
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "Tooltip": "Run any EffectCraft CLI command using safe JSON arguments.",
      "PropertyInspectorPath": "propertyInspector/run.html"
    },
    {
      "UUID": "wt.luizgustavo.getcraft.effectcraft.control",
      "Name": "EffectCraft Live Control",
      "Icon": "assets/action",
      "States": [{
        "Image": "assets/action",
        "TitleAlignment": "bottom",
        "TitleColor": "#FFFFFF",
        "FontSize": "12"
      }],
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "Tooltip": "Control the open EffectCraft project: playback, timeline, layers, effects and render queue.",
      "PropertyInspectorPath": "propertyInspector/workflow.html"
    },
    {
      "UUID": "wt.luizgustavo.getcraft.effectcraft.dial",
      "Name": "EffectCraft Property Dial",
      "Icon": "assets/action",
      "States": [{
        "Image": "assets/action",
        "TitleAlignment": "bottom",
        "TitleColor": "#FFFFFF",
        "FontSize": "12"
      }],
      "Controllers": ["Encoder"],
      "SupportedInMultiActions": true,
      "Tooltip": "Turn a Stream Deck rotary encoder to adjust the selected layer's opacity, rotation, scale or a numeric property. Press to toggle a keyframe.",
      "PropertyInspectorPath": "propertyInspector/dial.html"
    }
  ]
}
